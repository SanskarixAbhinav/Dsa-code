#include <stdio.h>
#include <stdlib.h>
#include <string.h>

void heapify(int arr[], int n, int i) {
    int largest = i;
    int left = 2 * i + 1;
    int right = 2 * i + 2;

    if (left < n && arr[left] > arr[largest])
        largest = left;
    if (right < n && arr[right] > arr[largest])
        largest = right;

    if (largest != i) {
        int temp = arr[i];
        arr[i] = arr[largest];
        arr[largest] = temp;
        heapify(arr, n, largest);
    }
}

void heapSort(int arr[], int n) {
    for (int i = n / 2 - 1; i >= 0; i--)
        heapify(arr, n, i);

    for (int i = n - 1; i > 0; i--) {
        int temp = arr[0];
        arr[0] = arr[i];
        arr[i] = temp;
        heapify(arr, i, 0);
    }
}

void heap_sort_demo(void) {
    int arr[] = {12, 11, 13, 5, 6, 7};
    int n = sizeof(arr) / sizeof(arr[0]);

    heapSort(arr, n);

    for (int i = 0; i < n; i++)
        printf("%d ", arr[i]);
    printf("\n");
}

#define TABLE_SIZE 101

typedef struct Node {
    char *key;
    int value;
    struct Node *next;
} Node;

typedef struct {
    Node *buckets[TABLE_SIZE];
} HashTable;

unsigned long hash(const char *str) {
    unsigned long h = 5381;
    int c;
    while ((c = *str++))
        h = ((h << 5) + h) + c;
    return h % TABLE_SIZE;
}

HashTable *create_table(void) {
    HashTable *table = malloc(sizeof(HashTable));
    for (int i = 0; i < TABLE_SIZE; i++)
        table->buckets[i] = NULL;
    return table;
}

void insert(HashTable *table, const char *key, int value) {
    unsigned long idx = hash(key);
    Node *cur = table->buckets[idx];

    while (cur) {
        if (strcmp(cur->key, key) == 0) {
            cur->value = value;
            return;
        }
        cur = cur->next;
    }

    Node *node = malloc(sizeof(Node));
    node->key = malloc(strlen(key) + 1);
    strcpy(node->key, key);
    node->value = value;
    node->next = table->buckets[idx];
    table->buckets[idx] = node;
}

int search(HashTable *table, const char *key, int *value) {
    Node *cur = table->buckets[hash(key)];
    while (cur) {
        if (strcmp(cur->key, key) == 0) {
            *value = cur->value;
            return 1;
        }
        cur = cur->next;
    }
    return 0;
}

int delete_key(HashTable *table, const char *key) {
    unsigned long idx = hash(key);
    Node *cur = table->buckets[idx];
    Node *prev = NULL;

    while (cur) {
        if (strcmp(cur->key, key) == 0) {
            if (prev)
                prev->next = cur->next;
            else
                table->buckets[idx] = cur->next;
            free(cur->key);
            free(cur);
            return 1;
        }
        prev = cur;
        cur = cur->next;
    }
    return 0;
}

void free_table(HashTable *table) {
    for (int i = 0; i < TABLE_SIZE; i++) {
        Node *cur = table->buckets[i];
        while (cur) {
            Node *next = cur->next;
            free(cur->key);
            free(cur);
            cur = next;
        }
    }
    free(table);
}

void hashing_demo(void) {
    HashTable *table = create_table();
    int value;

    insert(table, "apple", 10);
    insert(table, "banana", 20);
    insert(table, "cherry", 30);
    insert(table, "apple", 15);

    if (search(table, "apple", &value))
        printf("apple: %d\n", value);
    if (search(table, "banana", &value))
        printf("banana: %d\n", value);

    delete_key(table, "banana");

    if (!search(table, "banana", &value))
        printf("banana not found\n");

    free_table(table);
}

int main(void) {
    heap_sort_demo();
    hashing_demo();
    return 0;
}
